#!/usr/bin/env python3
"""Publish a privacy-safe Core3 status document for nginx to serve."""

import argparse
import json
import os
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path


SCHEMA_VERSION = 1


def utc_iso(timestamp):
	return datetime.fromtimestamp(timestamp, timezone.utc).isoformat().replace("+00:00", "Z")


def get_source_timestamp(source):
	time_msecs = source.get("timeMSecs")

	if isinstance(time_msecs, (int, float)) and time_msecs > 0:
		return time_msecs / 1000

	return None


def get_player_count(source):
	count = source.get("countOnline", source.get("countPlayers", 0))

	if not isinstance(count, int) or isinstance(count, bool):
		return 0

	return max(0, count)


def get_server_state(source):
	if source.get("isServerShuttingDown") is True:
		return "shutting_down"

	if source.get("isServerLoading") is True:
		return "loading"

	if source.get("isServerLocked") is True:
		return "locked"

	return "online"


def build_status(source_path, server_name, stale_seconds, now):
	public_status = {
		"schemaVersion": SCHEMA_VERSION,
		"server": server_name,
		"status": "offline",
		"playersOnline": 0,
		"uptimeSeconds": 0,
		"updatedAt": utc_iso(now),
		"sourceUpdatedAt": None,
	}

	try:
		with source_path.open("r", encoding="utf-8") as source_file:
			source = json.load(source_file)

		if not isinstance(source, dict):
			raise ValueError("the source JSON root is not an object")

		source_timestamp = get_source_timestamp(source)

		if source_timestamp is None:
			# Older Core3 output without timeMSecs can still be checked by mtime.
			source_timestamp = source_path.stat().st_mtime

		public_status["sourceUpdatedAt"] = utc_iso(source_timestamp)

		if now - source_timestamp <= stale_seconds:
			public_status["status"] = get_server_state(source)
			public_status["playersOnline"] = get_player_count(source)

			uptime = source.get("uptime", 0)
			if isinstance(uptime, int) and not isinstance(uptime, bool):
				public_status["uptimeSeconds"] = max(0, uptime)
	except (OSError, ValueError, json.JSONDecodeError) as error:
		print(f"Core3 status source unavailable: {error}", file=sys.stderr)

	return public_status


def atomic_write_json(output_path, status):
	output_path.parent.mkdir(parents=True, exist_ok=True)

	file_descriptor, temporary_name = tempfile.mkstemp(
		prefix=f".{output_path.name}.", dir=output_path.parent
	)

	try:
		with os.fdopen(file_descriptor, "w", encoding="utf-8", newline="\n") as output_file:
			json.dump(status, output_file, indent=2)
			output_file.write("\n")
			output_file.flush()
			os.fsync(output_file.fileno())

		os.chmod(temporary_name, 0o644)
		os.replace(temporary_name, output_path)
	except Exception:
		try:
			os.unlink(temporary_name)
		except OSError:
			pass
		raise


def parse_arguments():
	parser = argparse.ArgumentParser(
		description="Convert Core3 log/who.json into a public status.json"
	)
	parser.add_argument("--source", required=True, type=Path, help="private Core3 who.json")
	parser.add_argument("--output", required=True, type=Path, help="public status.json")
	parser.add_argument("--server-name", default="TC", help="public server label")
	parser.add_argument(
		"--stale-seconds",
		type=int,
		default=120,
		help="age after which the Core3 status is considered offline (default: 120)",
	)
	return parser.parse_args()


def main():
	arguments = parse_arguments()

	if arguments.stale_seconds < 1:
		raise SystemExit("--stale-seconds must be at least 1")

	now = datetime.now(timezone.utc).timestamp()
	status = build_status(
		arguments.source, arguments.server_name, arguments.stale_seconds, now
	)
	atomic_write_json(arguments.output, status)


if __name__ == "__main__":
	main()
