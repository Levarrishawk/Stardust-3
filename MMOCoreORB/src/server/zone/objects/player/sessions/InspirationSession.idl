package server.zone.objects.player.sessions;

import engine.util.Facade;
include server.zone.objects.player.sessions.InspirationState;

class InspirationSession extends Facade {
	@dereferenced
	protected transient InspirationState state;

	public InspirationSession() {
	}

	@local
	@dirty
	public InspirationState getInspirationState() {
		return state;
	}
}
