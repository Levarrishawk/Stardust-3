package server.zone.objects.player.sessions;

import engine.util.Facade;
include server.zone.objects.player.sessions.DecorationState;

class DecorationSession extends Facade {
	@dereferenced
	protected transient DecorationState state;

	public DecorationSession() {
	}

	@local
	@dirty
	public DecorationState getDecorationState() {
		return state;
	}
}
