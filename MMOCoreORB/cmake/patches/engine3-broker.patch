 DistributedObjectBroker* DistributedObjectBroker::initialize(const String& addr, int port) {
+	return initialize(addr, port, true);
+}
+
+DistributedObjectBroker* DistributedObjectBroker::initialize(const String& addr, int port, bool acceptBrokerPeers) {
+	if (!acceptBrokerPeers && !addr.isEmpty())
+		throw ServiceException("Single-process broker mode requires an empty root broker address");
+
 	DistributedObjectBroker* inst = DistributedObjectBroker::instance();
 	inst->address = addr;
 	inst->port = port;
+	inst->setHandler(new DOBServiceHandler(acceptBrokerPeers));
 
 	try {
 		if (addr.isEmpty())
 			inst->start(port);
 	} catch (const Exception& e) {
+		if (!acceptBrokerPeers)
+			throw;
+
 		inst->address = "127.0.0.1";
 	}
 
 	inst->initialize();
 
+	if (inst->address.isEmpty())
+		inst->info(true) << "Incoming broker peers " << (acceptBrokerPeers ? "enabled" : "disabled") << " on TCP port " << port;
+
 	return inst;
 }
 
